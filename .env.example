# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Admin login: signs the session cookie. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Contact form (Resend)
RESEND_API_KEY=
# the inbox that receives contact-form messages
CONTACT_TO_EMAIL=
# optional: a sender on a domain you verified in Resend; defaults to Resend's sandbox sender
# CONTACT_FROM_EMAIL="Portfolio Contact Form <contact@yourdomain.com>"

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# optional: your live URL, used for sitemap and share links (defaults to https://maanvikpoddar.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://maanvikpoddar.vercel.app
